+
+    /// Shows or hides the built-in Inspector panel without changing its session.
+    ///
+    /// Hiding the panel keeps hit testing and selection in this window active,
+    /// which allows another window to render the same Inspector entity.
+    #[cfg(any(feature = "inspector", debug_assertions))]
+    pub fn set_inspector_panel_visible(&mut self, visible: bool) {
+        self.a22_inspector.set_panel_visible(visible);
+        self.refresh();
+    }
+
+    /// Returns whether the built-in Inspector panel is rendered in this window.
+    #[cfg(any(feature = "inspector", debug_assertions))]
+    pub fn inspector_panel_visible(&self) -> bool {
+        self.a22_inspector.panel_visible()
+    }
+
+    /// Uses an Inspector session owned by another window for state edits.
+    ///
+    /// The target window still owns hit testing. This hook is for a detached
+    /// Inspector renderer that needs to edit the selected element's state.
+    #[cfg(any(feature = "inspector", debug_assertions))]
+    pub fn set_inspector_state_source(&mut self, inspector: Entity<Inspector>) {
+        self.a22_inspector.set_state_source(inspector);
+        self.refresh();
+    }
+
+    /// Clears the Inspector state source used by a detached renderer.
+    #[cfg(any(feature = "inspector", debug_assertions))]
+    pub fn clear_inspector_state_source(&mut self) {
+        self.a22_inspector.clear_state_source();
     }
 
